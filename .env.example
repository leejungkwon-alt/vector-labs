# SAJU — 환경변수 예시. 실제 값은 .env (gitignored) 에 넣으세요.

# --- Auth ---
SAJU_JWT_SECRET=
SAJU_JWT_TTL_SECONDS=2592000
# 운영: PostgreSQL(Cloud SQL) 연결 문자열. 설정하면 SQLite 대신 사용됨.
SAJU_DATABASE_URL=
# 개발/테스트용 SQLite 경로 (SAJU_DATABASE_URL 이 비어 있을 때만 사용).
# production 에서 DATABASE_URL 없이 이 값도 비어 있으면 기동 실패.
SAJU_AUTH_DB_PATH=data/auth.db
SAJU_REQUIRE_AUTH_FOR_REPORT=false

# --- Ops ---
SAJU_CORS_ORIGINS=*
SAJU_RATE_LIMIT_MAX=120
SAJU_RATE_LIMIT_WINDOW=60
SAJU_LOG_LEVEL=INFO
SAJU_LOG_FORMAT=text

# --- Environment (Step 4-B) ---
# development | production
# In production, mock tokens / default JWT secret / mock IAP receipts are rejected.
SAJU_ENV=development

# --- Auth Gating (Step 4-B) ---
SAJU_REQUIRE_AUTH_FOR_INTERPRET=false
SAJU_REQUIRE_AUTH_FOR_CALCULATE=false

# --- Telegram Mini App / 일일 푸시 ---
# 크론 시크릿: 16자 이상 필수. 비어 있으면 /telegram/push-daily 는 503 으로 비활성화됨.
# (운영에서는 Secret Manager 사용: --set-secrets)
SAJU_CRON_SECRET=
SAJU_TELEGRAM_BOT_TOKEN=
SAJU_WEBAPP_URL=https://vector-labs-three.vercel.app
SAJU_ASSET_BASE_URL=
