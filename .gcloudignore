# Cloud Build ignore — do NOT mirror .gitignore!
# Only exclude obviously unnecessary directories

.git/
.gitignore
.gcloudignore

# Frontend (backend doesn't need)
frontend/
tma/
node_modules/

# Local artifacts
review_export/
.review_backups/
__pycache__/
*.pyc
.pytest_cache/
*.pre_autofix*
*.pre_align*
*.pre_v2
*.pre_final
*.pre_align2
*.pre_align3
*.pre_final
.env
.env.*

# Local DB (Cloud Run uses /tmp/auth.db)
data/auth.db

# IDE
.vscode/
.idea/

# --- 2026-11 보안 정리 ---
# 시크릿/환경 파일 (이름이 .env 가 아니어도 전부 제외)
*.env
.env*
*.pem
*.key
*.p12
*.token
*.secret
*_credentials.json
*_service_account.json
scripts/_secrets_*

# 로컬 DB (운영은 PostgreSQL)
*.db
*.db-journal
*.db-wal
*.db-shm

# 정리 대상 / 백업 / 임시
_cleanup_trash/
scripts/_backups/
scripts/archive/
*.bak
*.bak_*
*.bak.*
*.pre_*
*.new
*.orig
*.backup

# 덤프 / 리포트 / 일회성 스크립트
code_dump.txt
*_dump.txt
report_dump.json
dump_code.py
apply_fixes.py
cleanup_repo.py
_patch_repo.py
cripts/

# 기타 불필요 항목
.github/
.vercel/
.vercelignore
docs/
