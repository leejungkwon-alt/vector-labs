# Vercel 자동 빌드용 .vercelignore
# 주의: `/app/` 처럼 앞에 슬래시를 붙여야 "루트의 app/ 폴더만" 제외됩니다.

# 의존성/캐시
node_modules
**/node_modules
__pycache__
**/__pycache__
*.pyc
.pytest_cache

# 빌드 산출물 (Vercel이 새로 만듦)
frontend/dist
**/dist

# 로컬 환경/인증
.env.local
.env.staging
.vercel
.vercelignore

# 백엔드 (Vercel에서 안 씀) — 앞에 / 붙여 루트만 제외
/app/
/scripts/
/tests/
/data/
/docs/
/prompts/
/review_export/
/backups/
/migrations/
/tma/
/Dockerfile
/docker-compose.yml
/.gcloudignore
/deploy.ps1
/conftest.py
/*.ps1

# dump/대용량 텍스트
/*.txt
/*.md

# 임시/백업
*.bak
*.bak_*
*.broken

# 2026-11 — 레거시 빌드 제외
/_cleanup_trash/
/saju_fixes/
middleware.py.new
add_city_lookup_i18n.py
*.py.new
*.backup