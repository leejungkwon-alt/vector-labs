# ... (write_core_section, write_energy_section 등 기존 코드 유지)

def _select_content(entry, *, user_id, birth_date, scope, discriminator):
    if isinstance(entry, dict):
        return entry
    if isinstance(entry, list) and entry:
        seed = make_seed(user_id=user_id, birth_date=birth_date, scope=scope, discriminator=discriminator)
        return pick_variant(entry, seed_parts=seed)
    return {}

# ============================================================
# YEAR
# ============================================================
def write_year_section(profile: dict, lang: str = "en", user_id: str | None = None) -> dict | None:
    year_theme = profile.get("year_theme")
    if not year_theme:
        return None

    pack = load_pack(lang, "year")
    theme_map = pack.get("YEAR_THEME_CONTENT", {})
    default_theme = pack.get("DEFAULT_YEAR_THEME", {})

    ten_god = year_theme.get("ten_god", "")
    raw = theme_map.get(ten_god, default_theme)
    
    # 변형 엔진 적용
    theme = _select_content(
        raw, user_id=user_id, birth_date=profile.get("birth_date"),
        scope="year", discriminator=str(year_theme.get("target_year"))
    )

