{
  "expo": {
    "name": "Vector Labs",
    "slug": "vector-labs",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gyeol",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1f769488-3d31-4767-8dca-ea79ae4d0b72"
      }
    },
    "owner": "vectorlaps-team",
    "android": {
      "package": "com.vectorlabs.gyeol"
    }
  }
}
