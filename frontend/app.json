{
  "expo": {
    "name": "Gyeol",
    "slug": "vector-labs",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gyeol",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121623"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-sharing",
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4a82ab2b-d0a8-42a0-864a-e2e8f99f9b51"
      }
    },
    "owner": "vectorlaps",
    "android": {
      "package": "com.vectorlabs.gyeol"
    }
  }
}
