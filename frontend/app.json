{
  "expo": {
    "name": "Vector Labs",
    "slug": "vector-labs",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "gyeol",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-sharing"
    ]
  }
}
